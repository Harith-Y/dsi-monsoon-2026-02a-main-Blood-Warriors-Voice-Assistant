# Copy to .env and fill in. .env is git-ignored; never commit real keys or numbers.

# Groq: answer generation (LLM), translation, and English speech-to-text (Whisper)
GROQ_API_KEY=
# Hugging Face token whose account accepted the terms of ai4bharat/indic-conformer-600m-multilingual (gated)
HF_TOKEN=

# Coordinator WhatsApp number for the "Chat with coordinator on WhatsApp" link (wa.me click-to-chat).
# Digits with country code, no + or spaces, e.g. 91XXXXXXXXXX. No phone calls: this is only a chat link.
COORDINATOR_WHATSAPP=
# Shared passcode for the coordinator pages (/dashboard, /teach). Digits only, at least 4, so coordinators
# can say it (any language, one number at a time) or tap it on the keypad. Empty = sign-in switched off.
COORDINATOR_PASSCODE=

# Optional: where things live. Defaults are inside the repo; the Docker image points them all at /data.
# BW_DATA_DIR=            # SQLite (coordinator requests, KB version history) and caregiver recordings; default data/runtime/
# BW_KB_PATH=             # the live knowledge base that /teach changes; default kb/entries.json
# BW_KB_VARIANTS_PATH=    # extra phrasings per entry; default kb/question_variants.json
# BW_INDEX_DIR=           # FAISS search index; default data/index/
# BW_TTS_CACHE_DIR=       # spoken answers and replies; default tts/cache/
# BW_LOG_PATH=            # request log (also feeds "This week" on the dashboard); default logs/requests.jsonl
# BW_ASR_WARMUP=1         # 0 skips loading the speech model at start-up
